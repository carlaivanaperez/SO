# ─── Base de datos ───────────────────────────────────────────────
# PostgreSQL. Prisma usa DOS URLs:
#   - DATABASE_URL: conexión "pooled" (la usa la app en runtime).
#   - DIRECT_URL:   conexión directa (la usan las migraciones).
#
# EN LOCAL (Docker: `docker compose up -d db`): apuntá ambas a la misma URL.
DATABASE_URL="postgresql://ferrestock:ferrestock@localhost:5432/ferrestock?schema=public"
DIRECT_URL="postgresql://ferrestock:ferrestock@localhost:5432/ferrestock?schema=public"
#
# EN NEON (nube gratis): en el panel del proyecto vas a ver ambas cadenas.
#   - DATABASE_URL → la que dice "Pooled connection" (el host incluye "-pooler").
#   - DIRECT_URL   → la conexión directa (mismo host sin "-pooler").
# Ejemplo (reemplazá usuario/clave/host reales):
#   DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/ferrestock?sslmode=require"
#   DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/ferrestock?sslmode=require"
#
# EN SUPABASE (otra nube gratis): Project Settings → Database → Connection string.
#   - DATABASE_URL → "Connection pooling" (Transaction mode, puerto 6543).
#   - DIRECT_URL   → "Direct connection" (puerto 5432).
# Ejemplo:
#   DATABASE_URL="postgresql://postgres.xxx:pass@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
#   DIRECT_URL="postgresql://postgres.xxx:pass@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ─── Autenticación ───────────────────────────────────────────────
# Secreto para firmar JWT del panel de administración. Generá uno con:
#   openssl rand -base64 32
JWT_SECRET="cambiame-en-produccion"
JWT_EXPIRES_IN="7d"

# ─── API ─────────────────────────────────────────────────────────
API_PORT=3001
# URL pública de la API (para webhooks de WhatsApp y CORS del front)
API_PUBLIC_URL="http://localhost:3001"
WEB_ORIGIN="http://localhost:3000"

# ─── WhatsApp Cloud API (Meta) ───────────────────────────────────
# Panel: https://developers.facebook.com/  → WhatsApp → API Setup
# Token que vos elegís y configurás en el webhook de Meta para verificarlo:
WHATSAPP_VERIFY_TOKEN="un-token-secreto-que-elegis-vos"
# Token de acceso del sistema (System User token, permanente):
WHATSAPP_ACCESS_TOKEN=""
# ID del número de teléfono de WhatsApp Business:
WHATSAPP_PHONE_NUMBER_ID=""
# App Secret para validar la firma X-Hub-Signature-256 de los webhooks:
WHATSAPP_APP_SECRET=""
