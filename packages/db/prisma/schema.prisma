// Esquema de datos de FerreStock.
// Convención: modelos y enums en inglés (PascalCase); nombres de tabla en
// snake_case vía @@map para que la base sea legible desde SQL directo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Usuarios del panel (staff de la ferretería) ─────────────────
enum UserRole {
  ADMIN // dueño / acceso total
  MANAGER // encargado: precios, stock, reportes
  CASHIER // cajero: solo ventas
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(CASHIER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sales          Sale[]
  stockMovements StockMovement[]

  @@map("users")
}

// ─── Catálogo ────────────────────────────────────────────────────
enum ProductUnit {
  UNIT // por unidad
  KG // por kilo
  METER // por metro (cables, cadenas)
  LITER // por litro (pinturas, solventes)
  BOX // por caja
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?    @map("parent_id")
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Product {
  id          String      @id @default(cuid())
  sku         String      @unique // código interno
  barcode     String?     @unique // código de barras (EAN/UPC)
  name        String
  description String?
  brand       String?
  unit        ProductUnit @default(UNIT)
  categoryId  String?     @map("category_id")
  category    Category?   @relation(fields: [categoryId], references: [id])

  // Precios vigentes (el historial vive en PriceHistory).
  costPrice Decimal @default(0) @map("cost_price") @db.Decimal(12, 2)
  salePrice Decimal @default(0) @map("sale_price") @db.Decimal(12, 2)
  taxRate   Decimal @default(21) @map("tax_rate") @db.Decimal(5, 2) // IVA % (AR = 21)

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stockItems     StockItem[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  priceHistory   PriceHistory[]
  whatsappQueries WhatsAppQuery[]

  @@index([name])
  @@map("products")
}

model PriceHistory {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  costPrice Decimal  @map("cost_price") @db.Decimal(12, 2)
  salePrice Decimal  @map("sale_price") @db.Decimal(12, 2)
  changedBy String?  @map("changed_by") // userId
  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@map("price_history")
}

// ─── Stock / Depósitos ───────────────────────────────────────────
model Warehouse {
  id        String  @id @default(cuid())
  name      String
  address   String?
  isDefault Boolean @default(false) @map("is_default")

  stockItems     StockItem[]
  stockMovements StockMovement[]

  @@map("warehouses")
}

// Stock actual de un producto en un depósito (snapshot; la verdad
// histórica es la suma de StockMovement).
model StockItem {
  id          String    @id @default(cuid())
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String    @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Decimal   @default(0) @db.Decimal(12, 3)
  minQuantity Decimal   @default(0) @map("min_quantity") @db.Decimal(12, 3) // punto de reposición

  @@unique([productId, warehouseId])
  @@map("stock_items")
}

enum StockMovementType {
  PURCHASE // ingreso por compra a proveedor
  SALE // egreso por venta
  ADJUSTMENT // ajuste manual de inventario
  RETURN // devolución de cliente
  TRANSFER // transferencia entre depósitos
}

// Libro mayor de movimientos de stock (append-only, auditable).
model StockMovement {
  id          String            @id @default(cuid())
  productId   String            @map("product_id")
  product     Product           @relation(fields: [productId], references: [id])
  warehouseId String            @map("warehouse_id")
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 3) // positivo=ingreso, negativo=egreso
  reason      String?
  saleId      String?           @map("sale_id")
  sale        Sale?             @relation(fields: [saleId], references: [id])
  userId      String?           @map("user_id")
  user        User?             @relation(fields: [userId], references: [id])
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@map("stock_movements")
}

// ─── Clientes ────────────────────────────────────────────────────
model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?  @unique // en formato E.164, ej: +5491122334455 (clave para WhatsApp)
  email     String?
  taxId     String?  @map("tax_id") // CUIT/DNI
  address   String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  sales           Sale[]
  whatsappQueries WhatsAppQuery[]

  @@map("customers")
}

// ─── Ventas ──────────────────────────────────────────────────────
enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  ACCOUNT // cuenta corriente
}

model Sale {
  id            String         @id @default(cuid())
  number        Int            @unique @default(autoincrement()) // número de comprobante
  customerId    String?        @map("customer_id")
  customer      Customer?      @relation(fields: [customerId], references: [id])
  userId        String         @map("user_id")
  user          User           @relation(fields: [userId], references: [id])
  status        SaleStatus     @default(DRAFT)
  paymentMethod PaymentMethod? @map("payment_method")

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items          SaleItem[]
  stockMovements StockMovement[]

  @@index([status, createdAt])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String  @map("sale_id")
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2) // precio congelado al momento de la venta
  discount  Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  @@map("sale_items")
}

// ─── WhatsApp: registro de consultas de stock ────────────────────
enum WhatsAppQueryStatus {
  RECEIVED
  MATCHED // se encontró producto
  NOT_FOUND
  RESPONDED
}

// Cada consulta entrante de un cliente por WhatsApp (para auditar,
// medir demanda y mejorar el matching de productos).
model WhatsAppQuery {
  id              String              @id @default(cuid())
  fromPhone       String              @map("from_phone") // E.164
  customerId      String?             @map("customer_id")
  customer        Customer?           @relation(fields: [customerId], references: [id])
  messageText     String              @map("message_text")
  matchedProductId String?            @map("matched_product_id")
  matchedProduct  Product?            @relation(fields: [matchedProductId], references: [id])
  status          WhatsAppQueryStatus @default(RECEIVED)
  responseText    String?             @map("response_text")
  createdAt       DateTime            @default(now()) @map("created_at")
  respondedAt     DateTime?           @map("responded_at")

  @@index([fromPhone, createdAt])
  @@map("whatsapp_queries")
}
