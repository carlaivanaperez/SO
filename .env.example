# ─── Base de datos ───────────────────────────────────────────────
# PostgreSQL. En desarrollo podés usar Docker: `docker compose up -d db`
DATABASE_URL="postgresql://ferrestock:ferrestock@localhost:5432/ferrestock?schema=public"

# ─── Autenticación ───────────────────────────────────────────────
# Secreto para firmar JWT del panel de administración. Generá uno con:
#   openssl rand -base64 32
JWT_SECRET="cambiame-en-produccion"
JWT_EXPIRES_IN="7d"

# ─── API ─────────────────────────────────────────────────────────
API_PORT=3001
# URL pública de la API (para webhooks de WhatsApp y CORS del front)
API_PUBLIC_URL="http://localhost:3001"
WEB_ORIGIN="http://localhost:3000"

# ─── WhatsApp Cloud API (Meta) ───────────────────────────────────
# Panel: https://developers.facebook.com/  → WhatsApp → API Setup
# Token que vos elegís y configurás en el webhook de Meta para verificarlo:
WHATSAPP_VERIFY_TOKEN="un-token-secreto-que-elegis-vos"
# Token de acceso del sistema (System User token, permanente):
WHATSAPP_ACCESS_TOKEN=""
# ID del número de teléfono de WhatsApp Business:
WHATSAPP_PHONE_NUMBER_ID=""
# App Secret para validar la firma X-Hub-Signature-256 de los webhooks:
WHATSAPP_APP_SECRET=""
