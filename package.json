{
  "name": "ferrestock",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de gestión para ferretería: ventas, stock, precios y consultas por WhatsApp",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:app": "turbo run dev --filter=@ferrestock/api --filter=@ferrestock/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @ferrestock/db generate",
    "db:migrate": "pnpm --filter @ferrestock/db migrate",
    "db:seed": "pnpm --filter @ferrestock/db seed",
    "db:studio": "pnpm --filter @ferrestock/db studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  }
}
