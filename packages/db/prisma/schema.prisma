// Esquema de datos de FerreStock.
// Convención: modelos y enums en inglés (PascalCase); nombres de tabla en
// snake_case vía @@map para que la base sea legible desde SQL directo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Conexión "pooled" (pgbouncer) para la app: aguanta muchas conexiones.
  url       = env("DATABASE_URL")
  // Conexión directa para migraciones (Neon/Supabase la exponen aparte).
  // En local con Docker apuntá ambas a la misma URL.
  directUrl = env("DIRECT_URL")
}

// ─── Usuarios del panel (staff de la ferretería) ─────────────────
enum UserRole {
  ADMIN // dueño / acceso total
  MANAGER // encargado: precios, stock, reportes
  CASHIER // cajero: solo ventas
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(CASHIER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sales            Sale[]
  stockMovements   StockMovement[]
  customerPayments CustomerPayment[]
  creditNotes      CreditNote[]

  @@map("users")
}

// ─── Catálogo ────────────────────────────────────────────────────
enum ProductUnit {
  UNIT // por unidad
  KG // por kilo
  METER // por metro (cables, cadenas)
  LITER // por litro (pinturas, solventes)
  BOX // por caja
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?    @map("parent_id")
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Product {
  id          String      @id @default(cuid())
  sku         String      @unique // código interno
  barcode     String?     @unique // código de barras (EAN/UPC)
  name        String
  description String?
  brand       String?
  unit        ProductUnit @default(UNIT)
  categoryId  String?     @map("category_id")
  category    Category?   @relation(fields: [categoryId], references: [id])

  // Precios vigentes (el historial vive en PriceHistory).
  costPrice Decimal @default(0) @map("cost_price") @db.Decimal(12, 2)
  salePrice Decimal @default(0) @map("sale_price") @db.Decimal(12, 2)
  taxRate   Decimal @default(21) @map("tax_rate") @db.Decimal(5, 2) // IVA % (AR = 21)

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stockItems      StockItem[]
  stockMovements  StockMovement[]
  saleItems       SaleItem[]
  priceHistory    PriceHistory[]
  whatsappQueries WhatsAppQuery[]
  promotions      Promotion[]

  @@index([name])
  @@map("products")
}

enum PromotionType {
  PERCENT // % de descuento
  TWO_FOR_ONE // 2x1: por cada 2 unidades, pagás 1
}

// Promoción de un producto con vigencia (fechas). El POS la aplica cuando está
// activa y dentro del rango, y congela el descuento en la venta.
model Promotion {
  id             String          @id @default(cuid())
  productId      String          @map("product_id")
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  type           PromotionType
  percent        Decimal?        @db.Decimal(5, 2) // solo para PERCENT (ej: 20.00)
  // Medios de pago donde aplica. Vacío = todos.
  paymentMethods PaymentMethod[] @map("payment_methods")
  startDate      DateTime        @map("start_date")
  endDate        DateTime        @map("end_date")
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([productId])
  @@map("promotions")
}

model PriceHistory {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  costPrice Decimal  @map("cost_price") @db.Decimal(12, 2)
  salePrice Decimal  @map("sale_price") @db.Decimal(12, 2)
  changedBy String?  @map("changed_by") // userId
  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@map("price_history")
}

// ─── Stock / Depósitos ───────────────────────────────────────────
model Warehouse {
  id        String  @id @default(cuid())
  name      String
  address   String?
  isDefault Boolean @default(false) @map("is_default")

  stockItems     StockItem[]
  stockMovements StockMovement[]

  @@map("warehouses")
}

// Stock actual de un producto en un depósito (snapshot; la verdad
// histórica es la suma de StockMovement).
model StockItem {
  id          String    @id @default(cuid())
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String    @map("warehouse_id")
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Decimal   @default(0) @db.Decimal(12, 3)
  minQuantity Decimal   @default(0) @map("min_quantity") @db.Decimal(12, 3) // punto de reposición

  @@unique([productId, warehouseId])
  @@map("stock_items")
}

enum StockMovementType {
  PURCHASE // ingreso por compra a proveedor
  SALE // egreso por venta
  ADJUSTMENT // ajuste manual de inventario
  RETURN // devolución de cliente
  TRANSFER // transferencia entre depósitos
}

// Libro mayor de movimientos de stock (append-only, auditable).
model StockMovement {
  id          String            @id @default(cuid())
  productId   String            @map("product_id")
  product     Product           @relation(fields: [productId], references: [id])
  warehouseId String            @map("warehouse_id")
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 3) // positivo=ingreso, negativo=egreso
  reason      String?
  saleId      String?           @map("sale_id")
  sale        Sale?             @relation(fields: [saleId], references: [id])
  userId      String?           @map("user_id")
  user        User?             @relation(fields: [userId], references: [id])
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@map("stock_movements")
}

// ─── Clientes ────────────────────────────────────────────────────
model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?  @unique // en formato E.164, ej: +5491122334455 (clave para WhatsApp)
  email     String?
  taxId     String?  @map("tax_id") // CUIT/DNI
  address   String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  sales           Sale[]
  whatsappQueries WhatsAppQuery[]
  payments        CustomerPayment[]
  creditNotes     CreditNote[]

  @@map("customers")
}

// Nota de crédito: crédito a favor del cliente (devolución, ajuste, error en
// una venta). Baja el saldo de la cuenta corriente igual que un pago, pero es
// un crédito otorgado por el negocio (no dinero que entró).
model CreditNote {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(12, 2)
  reason     String?
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([customerId, createdAt])
  @@map("credit_notes")
}

// Pagos que un cliente hace a su cuenta corriente. El saldo se calcula:
// (total de ventas con paymentMethod ACCOUNT) − (suma de estos pagos).
model CustomerPayment {
  id         String         @id @default(cuid())
  customerId String         @map("customer_id")
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount     Decimal        @db.Decimal(12, 2)
  method     PaymentMethod?
  note       String?
  userId     String?        @map("user_id")
  user       User?          @relation(fields: [userId], references: [id])
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([customerId, createdAt])
  @@map("customer_payments")
}

// ─── Ventas ──────────────────────────────────────────────────────
enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  ACCOUNT // cuenta corriente
}

model Sale {
  id            String         @id @default(cuid())
  number        Int            @unique @default(autoincrement()) // número de comprobante
  customerId    String?        @map("customer_id")
  customer      Customer?      @relation(fields: [customerId], references: [id])
  userId        String         @map("user_id")
  user          User           @relation(fields: [userId], references: [id])
  status        SaleStatus     @default(DRAFT)
  paymentMethod PaymentMethod? @map("payment_method")

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  // Financiación en cuotas (solo ventas a cuenta corriente).
  // installmentsCount = null → venta a cuenta abierta (sin plan de cuotas).
  installmentsCount  Int?    @map("installments_count")
  financingSurcharge Decimal @default(0) @map("financing_surcharge") @db.Decimal(12, 2) // recargo por financiar (ya incluido en total)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items          SaleItem[]
  stockMovements StockMovement[]
  installments   Installment[]

  @@index([status, createdAt])
  @@map("sales")
}

// Cuota de una venta financiada a cuenta corriente. El monto ya incluye la
// parte proporcional del recargo por financiación. El estado (pagada/vencida)
// no se guarda: se deriva imputando los pagos del cliente por vencimiento.
model Installment {
  id        String   @id @default(cuid())
  saleId    String   @map("sale_id")
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  number    Int // 1..N
  amount    Decimal  @db.Decimal(12, 2)
  dueDate   DateTime @map("due_date")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([saleId])
  @@index([dueDate])
  @@map("installments")
}

// Configuración de financiación (fila única, id = 1). Editable por ADMIN.
model FinanceConfig {
  id                  Int      @id @default(1)
  lateFeeDailyPercent Decimal  @default(0.3) @map("late_fee_daily_percent") @db.Decimal(6, 3) // interés por mora, % por día
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("finance_config")
}

// Escala de recargo por cantidad de cuotas (editable por ADMIN).
// Ej: 1 → 0%, 3 → 10%, 6 → 25%, 12 → 60%.
model InstallmentOption {
  installments     Int     @id
  surchargePercent Decimal @map("surcharge_percent") @db.Decimal(6, 2)

  @@map("installment_options")
}

// Datos del negocio (fila única id=1). Editable por ADMIN. Los usa el catálogo
// público: nombre a mostrar y WhatsApp para "reservar/pedir" (E.164).
model StoreSettings {
  id            Int      @id @default(1)
  storeName     String   @default("El Almacén del Ferretero") @map("store_name")
  whatsappPhone String?  @map("whatsapp_phone") // E.164, ej: +5493624721664
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String  @map("sale_id")
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2) // precio congelado al momento de la venta
  discount  Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  @@map("sale_items")
}

// ─── WhatsApp: registro de consultas de stock ────────────────────
enum WhatsAppQueryStatus {
  RECEIVED
  MATCHED // se encontró producto
  NOT_FOUND
  RESPONDED
}

// Cada consulta entrante de un cliente por WhatsApp (para auditar,
// medir demanda y mejorar el matching de productos).
model WhatsAppQuery {
  id               String              @id @default(cuid())
  fromPhone        String              @map("from_phone") // E.164
  customerId       String?             @map("customer_id")
  customer         Customer?           @relation(fields: [customerId], references: [id])
  messageText      String              @map("message_text")
  matchedProductId String?             @map("matched_product_id")
  matchedProduct   Product?            @relation(fields: [matchedProductId], references: [id])
  status           WhatsAppQueryStatus @default(RECEIVED)
  responseText     String?             @map("response_text")
  createdAt        DateTime            @default(now()) @map("created_at")
  respondedAt      DateTime?           @map("responded_at")

  @@index([fromPhone, createdAt])
  @@map("whatsapp_queries")
}
